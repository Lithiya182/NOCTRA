# ThermalGuard environment configuration
# Copy this file to .env and fill in real values.

# NASA FIRMS API key (register free: https://firms.modaps.eosdis.nasa.gov/api/map_key/)
FIRMS_MAP_KEY=YOUR_FIRMS_API_KEY_HERE

# Twilio (SMS) - free trial account: https://www.twilio.com/try-twilio
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Frontend URLs (CORS)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Database path
DB_PATH=data/thermalguard.db